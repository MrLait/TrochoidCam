<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:vm="using:KompasTrochoidCam.ViewModels"
        x:Class="KompasTrochoidCam.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="iMachining-Mini Плагин для КОМПАС-3D"
        Width="400" Height="450" WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <StackPanel Margin="20" Spacing="15">
    <TextBlock Text="Настройка трохоидального фрезерования" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>

    <!-- Статус подключения с возможностью копирования текста -->
    <Border Background="#EAEAEA" CornerRadius="5" Padding="10">
      <Grid ColumnDefinitions="Auto, *">
        <TextBlock Grid.Column="0" Text="Статус КОМПАС: " FontWeight="Bold" VerticalAlignment="Center"/>

        <!-- Используем TextBox вместо TextBlock для возможности выделения текста -->
        <TextBox Grid.Column="1"
                 Text="{Binding ConnectionStatus}"
                 Foreground="{Binding StatusColor}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 TextWrapping="Wrap"
                 Padding="0"
                 Margin="5,0,0,0"
                 VerticalAlignment="Center"/>
      </Grid>
    </Border>


    <!-- Параметры инструмента -->
    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" Margin="0,10,0,0">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Диаметр фрезы (мм):" VerticalAlignment="Center" Margin="0,5"/>
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ToolDiameter}" Margin="0,5"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Шаг трохоиды Ae (мм):" VerticalAlignment="Center" Margin="0,5"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TrochoidStep}" Margin="0,5"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Обороты S (об/мин):" VerticalAlignment="Center" Margin="0,5"/>
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SpindleSpeed}" Margin="0,5"/>

      <TextBlock Grid.Row="3" Grid.Column="0" Text="Подача F (мм/мин):" VerticalAlignment="Center" Margin="0,5"/>
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FeedRate}" Margin="0,5"/>
    </Grid>

    <!-- Кнопки управления -->
    <Button Content="Подключиться к КОМПАС" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#2196F3" Foreground="White" Height="35"/>
    <Button Content="Считать контур и создать .ngc" Command="{Binding GenerateGCodeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#4CAF50" Foreground="White" Height="35"/>

    <!-- Блок выбора постпроцессора и импорта файла -->
    <Border Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,10,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Постпроцессор станка:" FontWeight="Bold" FontSize="12"/>

        <!-- Выпадающий список прямо на главной форме -->
        <ComboBox ItemsSource="{Binding AvailablePosts}"
                  SelectedItem="{Binding SelectedPost}"
                  HorizontalAlignment="Stretch"
                  Height="32"/>

        <!-- Кнопка импорта. Она станет активной, только когда выбран станок -->
        <Button Content="Открыть сторонний G-код (.nc / .ngc)"
                Command="{Binding OpenGCodeFileCommand}"
                IsEnabled="{Binding IsPostSelected}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="#9C27B0"
                Foreground="White"
                Height="35"/>
      </StackPanel>
    </Border>



  </StackPanel>
</Window>