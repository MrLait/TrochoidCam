<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:KompasTrochoidCam.ViewModels"
        x:Class="KompasTrochoidCam.Views.GCodeWindow"
        x:DataType="vm:GCodeWindowViewModel"
        Title="Интерактивный 3D Визуализатор iMachining"
        Width="1000" Height="700" WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="350, *">
    <!-- Левая панель: Интерактивный список G-кода с салатовой подсветкой -->
    <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="10">

      <!-- Заменили TextBox на ListBox с привязкой к массиву строк -->
      <ListBox Grid.Row="0"
               Name="GCodeLinesList"
               ItemsSource="{Binding GCodeLines}"
               SelectedIndex="{Binding SelectedLineIndex, Mode=TwoWay}"
               FontFamily="Consolas"
               FontSize="12"
               ScrollViewer.VerticalScrollBarVisibility="Auto">

        <!-- Задаем стиль: перекрашиваем выделенную строку в салатовый цвет -->
        <ListBox.Styles>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#A2FF00"/>
            <!-- Сочный салатовый фон -->
            <Setter Property="Foreground" Value="Black"/>
            <!-- Черный текст на салатовом фоне -->
          </Style>
        </ListBox.Styles>
      </ListBox>

      <Button Grid.Row="1" Content="Копировать в буфер" Command="{Binding CopyCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Height="35" HorizontalContentAlignment="Center"/>
    </Grid>

    <!-- Правая панель: Интерактивный 3D-Холст остается без изменений -->
    <Border Grid.Column="1" Margin="10" Background="#111111" CornerRadius="5">
      <Grid>
        <Canvas Name="GCodeCanvas3D" Background="Transparent" ClipToBounds="True" PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved" PointerReleased="Canvas_PointerReleased" PointerWheelChanged="Canvas_PointerWheelChanged"/>
        <StackPanel Margin="15" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="5">
          <TextBlock Text="3D Визуализация трохоиды" Foreground="SpringGreen" FontSize="14" FontWeight="Bold"/>
          <TextBlock Text="Зажмите ЛКМ для вращения сцены" Foreground="#666666" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>